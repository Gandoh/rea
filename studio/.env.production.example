# ============================================================================
# REA Cloud Studio — PRODUCTION environment EXAMPLE
# ----------------------------------------------------------------------------
# This file contains NO real credentials or secrets — placeholders only.
# Copy to `.env.production` (git-ignored) or set these in your hosting
# provider's environment UI. Never commit real values to Git.
# ============================================================================

# Run mode — the startup validator enforces production rules when this is set.
NODE_ENV=production

# Bind address. Behind a TLS reverse proxy / Cloudflare Tunnel, 127.0.0.1 is
# safest (only the proxy can reach the app). Use 0.0.0.0 only if the app is
# directly exposed and the firewall restricts access.
HOST=127.0.0.1
PORT=3080

# REQUIRED in production: the exact public origin users' browsers use.
# Must be https:// (a free Cloudflare Tunnel or any TLS proxy provides this).
PUBLIC_BASE_URL=https://studio.example.com

# Comma-separated exact origins allowed for cross-origin API calls.
# Leave empty if the dashboard is served from the same origin (recommended).
# Example: https://studio.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=https://studio.example.com

# REQUIRED in production: persistent, mounted storage for the SQLite
# database and tenant store. NEVER /tmp or any ephemeral path.
# Example: a mounted block volume at /data.
REA_STUDIO_DATA_DIR=/data/rea-studio

# Ephemeral scratch space for uploads/samples (wiped on restart is fine).
REA_STUDIO_RUNTIME_DIR=/var/tmp/rea-studio-runtime

# ----------------------------------------------------------------------------
# Billing — intentionally DISABLED by default. Free-tier operation needs no
# keys at all; every billing endpoint reports "not configured" without them.
# Do NOT fill these in unless you deliberately activate paid billing.
# ----------------------------------------------------------------------------
KELVIQ_ENV=sandbox
# KELVIQ_SERVER_API_KEY=
# KELVIQ_CLIENT_API_KEY=
# KELVIQ_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Forbidden in production (the startup validator refuses to boot if set):
# ALLOW_SANDBOX_BILLING=true
ALLOW_SANDBOX_BILLING=

# Optional privileged bootstrap API key — leave EMPTY unless you know you need
# a headless bootstrap account.
REA_BOOTSTRAP_API_KEY=
