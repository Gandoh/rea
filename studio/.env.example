# ============================================================================
# Kelviq Merchant-of-Record Billing (Organization: Gandoh Bah Ai)
# Copy from https://app.kelviq.com/settings/setup-with-ai into .env.local
# or paste into Railway / Render Environment Variables. NEVER commit .env.local!
# ============================================================================
KELVIQ_SERVER_API_KEY=
KELVIQ_CLIENT_API_KEY=
KELVIQ_ENV=production
KELVIQ_WEBHOOK_SECRET=

# Public Plan Identifiers published in your Kelviq Dashboard -> Products:
KELVIQ_PRO_PLAN_ID=alphashield-pro
KELVIQ_WHALE_PLAN_ID=alphashield-whale
KELVIQ_ENTERPRISE_PLAN_ID=rea-ai-lab

# Optional direct hosted payment links (if using static CDN hosting before backend deploy):
KELVIQ_PRO_PAYMENT_LINK=
KELVIQ_WHALE_PAYMENT_LINK=
