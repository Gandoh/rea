# ============================================================================
# REA Cloud Studio & AlphaShield Security + Billing Configuration
# Copy into .env.local or configure in Railway / Render Environment Variables.
# NEVER commit .env.local or real secret keys to Git!
# ============================================================================

# Persistent SQLite data directory (REQUIRED outside /tmp in NODE_ENV=production):
REA_STUDIO_DATA_DIR=/data
REA_STUDIO_RUNTIME_DIR=/tmp/rea-studio-runtime

# Required in NODE_ENV=production for Origin enforcement & billing redirect safety:
PUBLIC_BASE_URL=https://studio.example.com

# Reverse-proxy trust configuration (comma-separated proxy socket IPs):
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_HOPS=1

# Optional CORS allowlist for external browser origins (comma-separated):
CORS_ALLOWED_ORIGINS=

# Kelviq Merchant-of-Record Billing:
KELVIQ_SERVER_API_KEY=
KELVIQ_CLIENT_API_KEY=
KELVIQ_ENV=production
KELVIQ_WEBHOOK_SECRET=

# Public Plan Identifiers published in your Kelviq Dashboard -> Products:
KELVIQ_PRO_PLAN_ID=alphashield-pro
KELVIQ_WHALE_PLAN_ID=alphashield-whale
KELVIQ_ENTERPRISE_PLAN_ID=rea-ai-lab

# Optional direct on-chain USDT checkout (disabled by default unless explicitly enabled):
ALPHASHIELD_ENABLE_DIRECT_USDT=false
ALPHASHIELD_MERCHANT_WALLET=
ALPHASHIELD_RPC_URL_BSC=
ALPHASHIELD_RPC_URL_ETHEREUM=
ALPHASHIELD_MIN_CONFIRMATIONS_BSC=15
ALPHASHIELD_MIN_CONFIRMATIONS_ETHEREUM=12
